# ── データベース ─────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── RSSブリッジ設定 ───────────────────────────────────────
RSS_BRIDGE_BASE_URL="https://nitter.net"

# rsshub.app を使う場合:
# RSS_BRIDGE_BASE_URL="https://rsshub.app/twitter/user"

# RSS取得間隔(分) — デフォルト: 5
CRON_INTERVAL_MINUTES="5"

# ── Next.js ───────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="X RSS Tracker"

# RSS����擾���i�f�t�H���g: 3�j
RSS_PARALLEL_LIMIT="3"
