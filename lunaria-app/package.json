{
  "name": "lunaria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NODE_ENV=development&& next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "env:check": "node scripts/env-check.js",
    "prod:check": "node scripts/prod-selfcheck.js",
    "lunaria:cycle": "node scripts/lunaria-improvement-cycle.js",
    "top:navigation": "node scripts/top-navigation-check.js",
    "game:carryover": "node scripts/game-carryover-check.js",
    "conversation:contract": "node scripts/conversation-contract-check.js",
    "gate": "npm run conversation:contract && npx tsx scripts/eval-mass.mts && npx tsx scripts/eval-mass-extraction.mts",
    "gate:conversation": "npx tsx scripts/eval-mass.mts",
    "gate:extraction": "npx tsx scripts/eval-mass-extraction.mts",
    "eval:luna": "npx tsx scripts/eval-luna.mts",
    "eval:edge": "npx tsx scripts/eval-luna-edge.mts",
    "eval:patterns": "npx tsx scripts/eval-luna-patterns.mts",
    "eval:extraction": "npx tsx scripts/eval-extraction.mts",
    "eval:next-step": "npx tsx scripts/eval-next-step.mts",
    "eval:weekly": "npx tsx scripts/eval-weekly-review.mts",
    "gacha:report": "node scripts/gacha-report.js",
    "gacha:smoke": "node scripts/gacha-smoke.js",
    "gacha:verify": "node scripts/gacha-verify.js",
    "gacha:sql-pack": "node scripts/gacha-sql-pack.js",
    "supabase:verify": "node scripts/supabase-verify.js",
    "character:sql-pack": "node scripts/character-sql-pack.js",
    "character:verify": "node scripts/character-verify.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.49.4",
    "next": "15.2.4",
    "openai": "^4.77.0",
    "postcss": "^8.5.8",
    "postcss-preset-env": "^11.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "typescript": "5.9.3"
  }
}
