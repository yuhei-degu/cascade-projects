# Lunaria local environment template
#
# Copy the variable names into .env.local and fill values from Supabase,
# Google AI Studio, and optional admin settings. Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Optional. Required only when protecting /api/admin/pool-stats in production.
LUNARIA_ADMIN_STATUS_TOKEN=

# Optional. Used by smoke/prod checks when testing a non-local deployment URL.
LUNARIA_BASE_URL=http://localhost:3000

# Optional. Only needed if Claude-backed routes are enabled later.
ANTHROPIC_API_KEY=
