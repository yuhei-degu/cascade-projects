# CascadeProjects monorepo: lunaria + lunaria-app のみ追跡
# 他プロジェクトは各々で git 化する想定

# トップレベルは基本的に全て除外
/*

# 追跡対象を明示
!/.gitignore
!/README.md
!/SPEC.md
!/PROGRESS.md
!/DECISIONS.md
!/TASKS.md
!/SECURITY.md
!/REVIEW_LOG.md
!/RELEASE_CHECKLIST.md
!/HANDOFF.md
!/lunaria/
!/lunaria-app/
!/ai-dev-os/
ai-dev-os/*
!/ai-dev-os/AI_DEV_OS/
ai-dev-os/AI_DEV_OS/*
!/ai-dev-os/AI_DEV_OS/LOGS/
ai-dev-os/AI_DEV_OS/LOGS/*
!/ai-dev-os/AI_DEV_OS/LOGS/*.md

# === 内部の除外ルール ===

# OS 生成ファイル
**/.DS_Store
**/Thumbs.db
**/desktop.ini

# エディタ設定
**/.vscode/settings.json
**/.cursor/
**/*.swp
**/*.swo

# 一時ファイル
**/*.tmp
**/*.log
**/*~

# Node.js / Next.js
**/node_modules/
**/npm-debug.log
**/.next/
**/*.tsbuildinfo

# Python
**/__pycache__/
**/*.pyc
**/venv/

# ビルド成果物
**/dist/
**/build/

# 環境変数
**/.env
**/.env.local
**/.env*.local
