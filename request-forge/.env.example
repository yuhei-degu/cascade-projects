# ── データベース ──────────────────────────────────────────
# PostgreSQL (ローカル開発: docker-compose up db)
DATABASE_URL="postgresql://postgres:password@localhost:5432/request_forge_db"

# ── Next.js ────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── AI APIキー ─────────────────────────────────────────────
# Gemini: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=""

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# ── メール送信 (Resend) ────────────────────────────────────
# https://resend.com/ → 無料プランあり (100通/日)
RESEND_API_KEY=""
FROM_EMAIL="noreply@yourdomain.com"

# 管理者メールアドレス（新規依頼通知の宛先）
ADMIN_EMAIL="admin@yourdomain.com"

# ── Stripe ────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Webhook署名 (stripe listen --forward-to localhost:3000/api/payment/webhook)
STRIPE_WEBHOOK_SECRET="whsec_..."
