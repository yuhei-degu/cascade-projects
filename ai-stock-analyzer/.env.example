# ── アプリ設定 ──────────────────────────────────────────────────
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# ── データベース ────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://postgres:changeme_strong_password@db:5432/ai_stock_db

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── 外部API ─────────────────────────────────────────────────────
# SEC EDGAR はメールアドレスが必須 (https://www.sec.gov/developer)
SEC_USER_AGENT=YourAppName your@email.com

# RapidAPI (Yahoo Finance Pro) - 無料プランでも基本データは取得可
RAPIDAPI_KEY=your_rapidapi_key_here

# USPTO Open Data Portal (https://developer.uspto.gov/)
USPTO_API_KEY=your_uspto_key_here

# ── NLP設定 ─────────────────────────────────────────────────────
NLP_DEVICE=cpu
# GPU使用時: NLP_DEVICE=cuda

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://your-production-domain.com

# ── フロントエンド ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
